{
  "name": "tubeless",
  "version": "0.4.8",
  "description": "Typed, agentic pipelines for TypeScript. Run locally, schedule on Tubeless Cloud.",
  "author": {
    "name": "Chet Mancini",
    "url": "https://github.com/chetmancini"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetmancini/tubeless.git"
  },
  "homepage": "https://tubeless.io/",
  "bugs": {
    "url": "https://github.com/chetmancini/tubeless/issues"
  },
  "keywords": [
    "pipeline",
    "workflow",
    "agent",
    "repl",
    "interactive",
    "dag",
    "typescript",
    "cli",
    "esm",
    "ai-agents",
    "llm",
    "mcp",
    "etl",
    "data-pipeline",
    "cron",
    "cloudflare-workers",
    "orchestration",
    "durable",
    "standard-schema",
    "ai-sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.14"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "tubeless": "./dist/workbench/workbench-launcher.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsrs -p tsconfig.json && bun scripts/generate-studio-client.mjs",
    "build:watch": "tsrs -p tsconfig.json --watch",
    "api:check": "node scripts/generate-api-reference.mjs --check",
    "api:diff": "node scripts/summarize-api-report-diff.mjs",
    "api:generate": "bun run build && node scripts/generate-api-reference.mjs",
    "studio:check": "bun scripts/generate-studio-client.mjs --check",
    "studio:watch": "bun scripts/watch-studio-client.mjs",
    "check": "bun run build && bun dist/workbench/workbench-bin.js run --trace logs/check.ndjson scripts/check-pipeline.ts -- --continue-on-error --max-concurrency 4",
    "docs:check": "node scripts/validate-learning-surface.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bunx --bun oxlint .",
    "knip": "knip",
    "pack:dry-run": "bun pm pack --dry-run --ignore-scripts",
    "tubeless": "bun run --silent build && bun dist/workbench/workbench-bin.js",
    "prepack": "bun run build",
    "test": "bun run build && bun run test:run",
    "test:run": "vitest run --config vitest.config.ts",
    "test:shard": "vitest run --config vitest.config.ts --shard \"${TEST_SHARD-1/1}\"",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --watch --config vitest.config.ts",
    "typecheck": "bun run build && bun run typecheck:run",
    "typecheck:run": "tsrs -p examples/tsconfig.json --noEmit && tsrs -p tsconfig.automation.json --noEmit && tsrs -p tsconfig.test.json --noEmit && tsrs -p design/tsconfig.json",
    "pack:verify": "node scripts/verify-packed-artifact.mjs",
    "eval:agent": "bun run build && node scripts/eval-agent.mjs"
  },
  "peerDependencies": {
    "ai": ">=7"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@dagster-io/dagster-pipes": "0.1.0",
    "@inngest/test": "1.0.0",
    "@interfere/landmines": "0.3.1",
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/testing": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "ai": "7.0.181",
    "cf": "1.0.0-rc.4",
    "inngest": "4.27.0",
    "knip": "6.48.0",
    "miniflare": "5.20261119.0-beta",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "7.0.2",
    "typescript-floor": "npm:typescript@5.4.5",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "rimraf": "6.1.4"
  },
  "exports": {
    "./agent/node": {
      "types": "./dist/agent/node.d.ts",
      "import": "./dist/agent/node.js",
      "default": "./dist/agent/node.js"
    },
    "./agent": {
      "types": "./dist/agent/agent.d.ts",
      "import": "./dist/agent/agent.js",
      "default": "./dist/agent/agent.js"
    },
    ".": {
      "types": "./dist/core/pipeline.d.ts",
      "import": "./dist/core/pipeline.js",
      "default": "./dist/core/pipeline.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "import": "./dist/cli/cli.js",
      "default": "./dist/cli/cli.js"
    },
    "./batch": {
      "types": "./dist/utilities/batch.d.ts",
      "import": "./dist/utilities/batch.js",
      "default": "./dist/utilities/batch.js"
    },
    "./node": {
      "types": "./dist/node/node.d.ts",
      "import": "./dist/node/node.js",
      "default": "./dist/node/node.js"
    },
    "./rate-limit": {
      "types": "./dist/utilities/rate-limit.d.ts",
      "import": "./dist/utilities/rate-limit.js",
      "default": "./dist/utilities/rate-limit.js"
    },
    "./retry": {
      "types": "./dist/utilities/retry.d.ts",
      "import": "./dist/utilities/retry.js",
      "default": "./dist/utilities/retry.js"
    },
    "./project": {
      "types": "./dist/project/project.d.ts",
      "import": "./dist/project/project.js",
      "default": "./dist/project/project.js"
    },
    "./testing": {
      "types": "./dist/testing/testing.d.ts",
      "import": "./dist/testing/testing.js",
      "default": "./dist/testing/testing.js"
    },
    "./tracing": {
      "types": "./dist/tracing/tracing.d.ts",
      "import": "./dist/tracing/tracing.js",
      "default": "./dist/tracing/tracing.js"
    },
    "./agent/openai": {
      "types": "./dist/agent/openai.d.ts",
      "import": "./dist/agent/openai.js",
      "default": "./dist/agent/openai.js"
    },
    "./agent/mcp": {
      "types": "./dist/agent/mcp.d.ts",
      "import": "./dist/agent/mcp.js",
      "default": "./dist/agent/mcp.js"
    },
    "./agent/anthropic": {
      "types": "./dist/agent/anthropic.d.ts",
      "import": "./dist/agent/anthropic.js",
      "default": "./dist/agent/anthropic.js"
    },
    "./agent/ai-sdk": {
      "types": "./dist/agent/ai-sdk.d.ts",
      "import": "./dist/agent/ai-sdk.js",
      "default": "./dist/agent/ai-sdk.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/cloudflare.d.ts",
      "import": "./dist/cloudflare/cloudflare.js",
      "default": "./dist/cloudflare/cloudflare.js"
    },
    "./cloudflare/cache": {
      "types": "./dist/cloudflare/cloudflare-cache.d.ts",
      "import": "./dist/cloudflare/cloudflare-cache.js",
      "default": "./dist/cloudflare/cloudflare-cache.js"
    },
    "./cloudflare/transcript": {
      "types": "./dist/cloudflare/cloudflare-transcript.d.ts",
      "import": "./dist/cloudflare/cloudflare-transcript.js",
      "default": "./dist/cloudflare/cloudflare-transcript.js"
    },
    "./check-report": {
      "types": "./dist/utilities/check-report.d.ts",
      "import": "./dist/utilities/check-report.js",
      "default": "./dist/utilities/check-report.js"
    },
    "./check-plan": {
      "types": "./dist/utilities/node-check-plan.d.ts",
      "import": "./dist/utilities/node-check-plan.js",
      "default": "./dist/utilities/node-check-plan.js"
    },
    "./reproduction-manifest": {
      "types": "./dist/utilities/reproduction-manifest.d.ts",
      "import": "./dist/utilities/reproduction-manifest.js",
      "default": "./dist/utilities/reproduction-manifest.js"
    },
    "./node/check": {
      "types": "./dist/check/node-check.d.ts",
      "import": "./dist/check/node-check.js",
      "default": "./dist/check/node-check.js"
    }
  }
}
