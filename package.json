{
  "name": "tubeless",
  "version": "0.2.1",
  "description": "Typed pipeline primitives for composable data-processing workflows.",
  "author": {
    "name": "Chet Mancini",
    "url": "https://github.com/chetmancini"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetmancini/tubeless.git"
  },
  "homepage": "https://chetmancini.github.io/tubeless/",
  "bugs": {
    "url": "https://github.com/chetmancini/tubeless/issues"
  },
  "keywords": [
    "pipeline",
    "workflow",
    "typescript",
    "cli",
    "esm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "tubeless": "./dist/workbench/workbench-bin.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/generate-studio-client.mjs --dist",
    "api:check": "node scripts/generate-api-reference.mjs --check",
    "api:generate": "bun run build && node scripts/generate-api-reference.mjs",
    "studio:check": "node scripts/generate-studio-client.mjs --check",
    "studio:generate": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/generate-studio-client.mjs",
    "check": "bun run build && bun run lint:run && bun run knip && bun run format:check && bun run typecheck:run && bun run docs:check && bun run api:check && bun run studio:check && bun run test:run && bun run eval:verify && bun run pack:verify",
    "docs:check": "node scripts/validate-learning-surface.mjs",
    "eval:agent": "node scripts/evaluate-agent-submission.mjs",
    "eval:verify": "node scripts/verify-agent-evaluation-runner.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun run build && bun run lint:run",
    "lint:run": "bunx --bun oxlint .",
    "knip": "knip",
    "tubeless": "bun run --silent build && bun dist/workbench/workbench-bin.js",
    "prepack": "bun run build",
    "test": "bun run build && bun run test:run",
    "test:run": "vitest run --config vitest.config.ts",
    "typecheck": "bun run build && bun run typecheck:run",
    "typecheck:run": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pack:verify": "node scripts/verify-packed-artifact.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "26.4.1",
    "knip": "6.35.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/core/pipeline.d.ts",
      "import": "./dist/core/pipeline.js",
      "default": "./dist/core/pipeline.js"
    },
    "./batch": {
      "types": "./dist/utilities/batch.d.ts",
      "import": "./dist/utilities/batch.js",
      "default": "./dist/utilities/batch.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "import": "./dist/cli/cli.js",
      "default": "./dist/cli/cli.js"
    },
    "./node": {
      "types": "./dist/node/node.d.ts",
      "import": "./dist/node/node.js",
      "default": "./dist/node/node.js"
    },
    "./rate-limit": {
      "types": "./dist/utilities/rate-limit.d.ts",
      "import": "./dist/utilities/rate-limit.js",
      "default": "./dist/utilities/rate-limit.js"
    },
    "./render": {
      "types": "./dist/render/render.d.ts",
      "import": "./dist/render/render.js",
      "default": "./dist/render/render.js"
    },
    "./reporter": {
      "types": "./dist/reporter/reporter-entry.d.ts",
      "import": "./dist/reporter/reporter-entry.js",
      "default": "./dist/reporter/reporter-entry.js"
    },
    "./retry": {
      "types": "./dist/utilities/retry.d.ts",
      "import": "./dist/utilities/retry.js",
      "default": "./dist/utilities/retry.js"
    },
    "./run-store": {
      "types": "./dist/run-store/run-store.d.ts",
      "import": "./dist/run-store/run-store.js",
      "default": "./dist/run-store/run-store.js"
    },
    "./run-store/sqlite": {
      "types": "./dist/run-store/run-store-sqlite.d.ts",
      "import": "./dist/run-store/run-store-sqlite.js",
      "default": "./dist/run-store/run-store-sqlite.js"
    },
    "./run-store/ndjson": {
      "types": "./dist/run-store/run-store-ndjson.d.ts",
      "import": "./dist/run-store/run-store-ndjson.js",
      "default": "./dist/run-store/run-store-ndjson.js"
    },
    "./workbench/studio": {
      "types": "./dist/workbench/workbench-studio.d.ts",
      "import": "./dist/workbench/workbench-studio.js",
      "default": "./dist/workbench/workbench-studio.js"
    },
    "./workbench/project": {
      "types": "./dist/workbench/workbench-project.d.ts",
      "import": "./dist/workbench/workbench-project.js",
      "default": "./dist/workbench/workbench-project.js"
    },
    "./run-store/ui": {
      "types": "./dist/studio/run-store-ui.d.ts",
      "import": "./dist/studio/run-store-ui.js",
      "default": "./dist/studio/run-store-ui.js"
    },
    "./testing": {
      "types": "./dist/testing/testing.d.ts",
      "import": "./dist/testing/testing.js",
      "default": "./dist/testing/testing.js"
    },
    "./tracing": {
      "types": "./dist/tracing/tracing.d.ts",
      "import": "./dist/tracing/tracing.js",
      "default": "./dist/tracing/tracing.js"
    },
    "./tracing/json": {
      "types": "./dist/tracing/tracing-json.d.ts",
      "import": "./dist/tracing/tracing-json.js",
      "default": "./dist/tracing/tracing-json.js"
    },
    "./tracing/otel": {
      "types": "./dist/tracing/tracing-otel.d.ts",
      "import": "./dist/tracing/tracing-otel.js",
      "default": "./dist/tracing/tracing-otel.js"
    }
  }
}
