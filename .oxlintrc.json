{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "jsPlugins": [{ "name": "landmines", "specifier": "@interfere/landmines" }],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "scripts/fixtures/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "website/**"
  ],
  "rules": {
    "no-debugger": "error",
    "no-fallthrough": "error",
    "no-unsafe-optional-chaining": "error",
    "no-control-regex": "off",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "prefer-const": [
      "error",
      {
        "ignoreReadBeforeAssign": true
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": false
      }
    ],
    "no-param-reassign": "error",
    "default-param-last": "error",
    "no-multi-assign": "error",
    "no-implicit-coercion": "error",
    "no-loop-func": "error",
    "prefer-object-spread": "error",
    "no-throw-literal": "error",
    "object-shorthand": "error",
    "arrow-body-style": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "import/no-duplicates": "error",
    "import/first": "error",
    "no-array-constructor": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-else-return": "error",
    "no-lonely-if": "error",
    "no-new": "error",
    "no-self-compare": "error",
    "no-unneeded-ternary": "error",
    "no-useless-catch": "error",
    "no-useless-constructor": "error",
    "no-useless-return": "error",
    "no-var": "error",
    "prefer-rest-params": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/unbound-method": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": false
      }
    ],
    "typescript/no-mixed-enums": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/only-throw-error": [
      "error",
      {
        "allowThrowingUnknown": true
      }
    ],
    "typescript/prefer-find": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-promise-reject-errors": [
      "error",
      {
        "allowThrowingUnknown": true
      }
    ],
    "typescript/prefer-readonly": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/triple-slash-reference": "error",
    "import/no-cycle": "error",
    "import/no-mutable-exports": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": "error",
    "landmines/no-clipboard-read-text": "error",
    "landmines/no-cold-import-in-test": "error",
    "landmines/no-elapsed-time-bound": "error",
    "landmines/no-fixed-sleep": "error",
    "landmines/no-flake-masking": [
      "error",
      {
        "allow": {
          "scripts/check-release-commit.test.ts": 2,
          "scripts/cut-release.test.ts": 1,
          "scripts/eval-agent.test.ts": 4,
          "src/agent/codemode.test.ts": 2,
          "src/agent/durability-process.test.ts": 1,
          "src/agent/mcp-stdio.test.ts": 1,
          "src/agent/mcp.test.ts": 1,
          "src/check/node-check.test.ts": 4,
          "src/cloudflare/cloudflare-app.test.ts": 2,
          "src/cloudflare/cloudflare-launch-app.test.ts": 3,
          "src/cloudflare/cloudflare-runner.test.ts": 4,
          "src/core/execution-journal-process.test.ts": 1,
          "src/node/vitest-report.test.ts": 1,
          "src/run-store/run-store-sqlite.test.ts": 1,
          "src/testing/dagster.example.test.ts": 1,
          "src/testing/step-functions.example.test.ts": 1,
          "src/testing/step-output/recovery.example.test.ts": 2,
          "src/testing/temporal.example.test.ts": 1,
          "src/workbench/agent/history.test.ts": 1,
          "src/workbench/collector/host.test.ts": 1,
          "src/workbench/collector/worker.test.ts": 1,
          "src/workbench/transcript-history.test.ts": 1,
          "src/workbench/workbench-reproduce.test.ts": 1,
          "src/workbench/workbench-ui-integration.test.ts": 3,
          "src/workbench/workbench-ui.test.ts": 1
        }
      }
    ],
    "landmines/no-imported-mutation": "error",
    "landmines/no-inline-hex-encoding": "error",
    "landmines/no-prefix-cluster": [
      "error",
      {
        "allow": {
          "examples/agent-*": 20,
          "examples/step-*": 4,
          "examples/yaml-*": 3,
          "src/agent/checkpoint-*": 7,
          "src/agent/codemode-*": 7,
          "src/agent/default-*": 8,
          "src/agent/mcp-*": 6,
          "src/agent/model-*": 5,
          "src/agent/openai-*": 4,
          "src/agent/provider-*": 10,
          "src/agent/tool-*": 4,
          "src/core/child-*": 13,
          "src/core/execution-*": 5,
          "src/core/pipeline-*": 46,
          "src/hosting/execution-*": 3,
          "src/hosting/launch-*": 7,
          "src/node/worker-*": 3,
          "src/testing/agent-*": 4,
          "src/utilities/cache-*": 3
        }
      }
    ],
    "landmines/no-project-max-workers": "error",
    "landmines/no-self-container-query": "error",
    "landmines/no-shared-signal": "error",
    "landmines/no-silent-catch": "error",
    "landmines/no-stale-render-assertion": "error",
    "landmines/no-styling-class-assertion": "error",
    "landmines/no-unsignaled-poll": "error",
    "landmines/package-exports": "error",
    "landmines/strict-msw": "error",
    "landmines/test-file-names": "error"
  },
