              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cloudflare/**"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test-support.ts",
        "src/cloudflare/cloudflare.ts"
