---
import Base from "../layouts/Base.astro";
import Install from "../components/Install.astro";
import LiveTerminal from "../components/LiveTerminal.astro";
import MermaidGraph from "../components/MermaidGraph.astro";
import Terminal from "../components/Terminal.astro";
import TtyBar from "../components/TtyBar.astro";
import { planTape } from "../data/tapes";
import { PACKAGE } from "../lib/package";
import { absUrl, GITHUB_REPO, githubBlob, href } from "../lib/paths";
---

<Base
  title="Tubeless"
  markdown="index.md"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${absUrl()}#software`,
    name: "Tubeless",
    description: PACKAGE.description,
    url: absUrl(),
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Cross-platform",
    softwareVersion: PACKAGE.version,
    license: `${GITHUB_REPO}/blob/main/LICENSE`,
    sameAs: [GITHUB_REPO],
    author: { "@type": "Person", name: "Chet Mancini", url: "https://github.com/chetmancini" },
  }}
  description="Tubeless by Chet Mancini: dependency-free TypeScript primitives for typed data pipelines and multi-step workflow graphs."
>
  <main>
    <section class="wrap hero">
      <svg class="hero-wheel" viewBox="0 0 400 400" aria-hidden="true">
        <g fill="none" stroke="#121212" stroke-width="1.2">
          <circle cx="200" cy="200" r="186"></circle>
          <circle cx="200" cy="200" r="168"></circle>
          <circle cx="200" cy="200" r="42"></circle>
          <circle cx="200" cy="200" r="18"></circle>
        </g>
        <g fill="none" stroke="#121212" stroke-width="1">
          <path d="M200 58v114"></path>
          <path d="M200 228v114"></path>
          <path d="M58 200h114"></path>
          <path d="M228 200h114"></path>
          <path d="M99.7 99.7l80.6 80.6"></path>
          <path d="M219.7 219.7l80.6 80.6"></path>
          <path d="M300.3 99.7l-80.6 80.6"></path>
          <path d="M180.3 219.7l-80.6 80.6"></path>
        </g>
        <path d="M200 14v36" stroke="#c4a046" stroke-width="3.2"></path>
        <circle cx="200" cy="16" r="7" fill="#c4a046"></circle>
      </svg>
      <div>
        <h1>Tubeless</h1>
        <p class="lede">
          Typed pipelines for Node.js. Define dependencies, preview execution,
          and inspect step results.
        </p>
        <Install command={`npm install ${PACKAGE.name}`} />
        <div class="actions">
          <a class="btn" href={href("start")}>Getting started</a>
          <a class="btn ghost" href={href("agents")}>Agent documentation</a>
        </div>
      </div>
      <Terminal tape={planTape} />
    </section>

    <div class="wrap package-strip">
        <dl class="pkg" aria-label="Package">
          <div>
            <dt>Version</dt>
            <dd>
              {PACKAGE.npm ? (
                <a href={PACKAGE.npm} rel="noreferrer">{PACKAGE.version}</a>
              ) : (
                PACKAGE.version
              )}
            </dd>
          </div>
          <div>
            <dt>License</dt>
            <dd>
              <a href={githubBlob("LICENSE")} rel="noreferrer">{PACKAGE.license}</a>
            </dd>
          </div>
          <div>
            <dt>Module</dt>
            <dd>{PACKAGE.module}</dd>
          </div>
          <div>
            <dt>Node</dt>
            <dd>{PACKAGE.node}</dd>
          </div>
          <div>
            <dt>Deps</dt>
            <dd>{PACKAGE.runtimeDeps}</dd>
          </div>
        </dl>
    </div>

    <section class="wrap section">
      <div class="section-head">
        <div>
          <h2>Runtime</h2>
        </div>
        <p>
          Import <code>createSteps</code> and <code>definePipeline</code>. Invalid graphs fail at definition.
          <code>plan()</code> previews selection. <code>run</code> / <code>runOrThrow</code> execute. The CLI is a Bun
          workbench around the same exports.
        </p>
      </div>
      <div class="facts">
        <article>
          <h3>Library</h3>
          <p>ESM-only, dependency-free compiled JavaScript. Node.js 22+ on Linux and macOS.</p>
        </article>
        <article>
          <h3>CLI</h3>
          <p><code>inspect</code>, <code>plan</code>, <code>graph</code>, <code>run</code>, and <code>ui</code>. Bun 1.3.14+. <code>npx tubeless</code> relaunches through Bun.</p>
        </article>
        <article>
          <h3>Execution</h3>
          <p>Pipelines run in your Node.js process. No separate server is required.</p>
        </article>
      </div>
    </section>

    <section class="wrap section">
      <div class="feature">
        <div class="feature-copy">
          <h2>Define</h2>
          <p>
            Steps declare typed inputs and outputs. Pipeline definitions reject
            missing dependencies, cycles, and duplicate IDs. Plans, reports,
            hooks, and CLI selection use the declared step IDs.
          </p>
        </div>
        <figure class="shot">
          <TtyBar title="import.ts" host="library" />
          <pre><code>{`import { createSteps, definePipeline, requireOutputs } from "tubeless";

interface ImportOptions {
  lines: readonly string[];
}

const step = createSteps<ImportOptions>();

const load = step("load", {
  run: (_inputs, context) => context.options.lines,
});

const normalize = step("normalize", {
  dependsOn: [load],
  run: ({ load: rows }) =>
    rows.map((row) => row.trim().toLowerCase()).filter(Boolean),
});

export const ImportPipeline = definePipeline({
  id: "import",
  steps: [load, normalize],
  targets: [normalize],
  finalize: requireOutputs([normalize], ({ normalize }) => normalize),
});`}</code></pre>
        </figure>
      </div>
    </section>

    <section class="wrap section">
      <div class="feature reverse">
        <div class="feature-copy">
          <h2>Plan</h2>
          <p>
            <code>plan()</code> lists the steps selected for a target without
            executing them. Export the dependency graph as Mermaid with
            <code>toMermaid()</code>.
          </p>
        </div>
        <MermaidGraph />
      </div>
    </section>

    <section class="wrap section">
      <div class="feature">
        <div class="feature-copy">
          <h2>Run</h2>
          <p>
            <code>run()</code> returns step results, failures, and timings.
            The terminal reporter displays progress during execution.
            Run history can be stored in SQLite or exported as NDJSON.
          </p>
        </div>
        <LiveTerminal />
      </div>
    </section>

    <section class="wrap section">
      <div class="feature reverse">
        <div class="feature-copy">
          <h2>Studio</h2>
          <p>
            The local studio displays recorded runs, step timelines, and
            nested pipelines from SQLite or NDJSON history.
          </p>
        </div>
        <figure class="shot">
          <TtyBar title="tubeless ui" host="studio" />
          <img
            src={href("studio.png")}
            width="1440"
            height="813"
            loading="lazy"
            alt="Local studio listing completed import and publish runs, with the import step timeline and a nested normalize run selected."
          />
        </figure>
      </div>
    </section>
    <section class="wrap section next-steps" aria-labelledby="next-heading">
      <h2 id="next-heading">Documentation</h2>
      <div class="agent-grid">
        <a href={href("start")}><h3>Getting started</h3></a>
        <a href={href("agents")}><h3>Agent documentation</h3></a>
        <a href={href("docs/recipes")}><h3>Recipes</h3></a>
        <a href={href("docs/concepts")}><h3>Execution semantics</h3></a>
      </div>
    </section>
  </main>
</Base>
