---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Install from "../components/Install.astro";
import LiveTerminal from "../components/LiveTerminal.astro";
import MermaidGraph from "../components/MermaidGraph.astro";
import PipelineFlow from "../components/PipelineFlow.astro";
import Terminal from "../components/Terminal.astro";
import TtyBar from "../components/TtyBar.astro";
import { FIRST_PIPELINE_SAMPLE } from "../data/code-samples";
import { USE_CASES } from "../data/use-cases";
import { planTape } from "../data/tapes";
import { PACKAGE } from "../lib/package";
import { absUrl, GITHUB_REPO, githubBlob, href } from "../lib/paths";
---

<Base
  title="Tubeless"
  markdown="index.md"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${absUrl()}#software`,
    name: "Tubeless",
    alternateName: "Tubeless TypeScript Pipelines",
    description: PACKAGE.description,
    url: absUrl(),
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Cross-platform",
    softwareVersion: PACKAGE.version,
    keywords: ["TypeScript pipelines", "Node.js workflows", "typed ETL"],
    license: `${GITHUB_REPO}/blob/main/LICENSE`,
    sameAs: [GITHUB_REPO],
    author: { "@type": "Person", name: "Chet Mancini", url: "https://github.com/chetmancini" },
  }}
  description="Tubeless is a TypeScript library for data pipelines and multi-step workflows, with no runtime dependencies."
>
  <main>
    <PipelineFlow>
      <section class="wrap hero">
        <svg class="hero-wheel" viewBox="0 0 400 400" aria-hidden="true">
          <g fill="none" stroke="#121212" stroke-width="1.2">
            <circle cx="200" cy="200" r="186"></circle>
            <circle cx="200" cy="200" r="168"></circle>
            <circle cx="200" cy="200" r="42"></circle>
            <circle cx="200" cy="200" r="18"></circle>
          </g>
          <g fill="none" stroke="#121212" stroke-width="1">
            <path d="M200 58v114"></path>
            <path d="M200 228v114"></path>
            <path d="M58 200h114"></path>
            <path d="M228 200h114"></path>
            <path d="M99.7 99.7l80.6 80.6"></path>
            <path d="M219.7 219.7l80.6 80.6"></path>
            <path d="M300.3 99.7l-80.6 80.6"></path>
            <path d="M180.3 219.7l-80.6 80.6"></path>
          </g>
          <path d="M200 14v36" stroke="#c4a046" stroke-width="3.2"></path>
          <circle cx="200" cy="16" r="7" fill="#c4a046"></circle>
        </svg>
        <div>
          <h1>Tubeless</h1>
          <p class="lede">
            Typed pipelines for Node.js. Define dependencies, preview execution,
            and inspect step results.
          </p>
          <Install command={`npm install ${PACKAGE.name}`} />
          <div class="actions">
            <a class="btn" href={href("start")}>Getting started</a>
            <a class="btn ghost" href={href("agents")}>Agent documentation</a>
          </div>
          <aside class="agent-tip" aria-label="Coding agent setup">
            <p>
              <a href={href("docs/agent-skills")}>Install skills for your coding agent ↗</a>
            </p>
            <Install command="npx skills add chetmancini/tubeless" />
          </aside>
        </div>
        <Terminal tape={planTape} />
      </section>

      <div class="wrap package-strip">
          <dl class="pkg" aria-label="Package">
            <div>
              <dt>Version</dt>
              <dd>
                {PACKAGE.npm ? (
                  <a href={PACKAGE.npm} rel="noreferrer">{PACKAGE.version}</a>
                ) : (
                  PACKAGE.version
                )}
              </dd>
            </div>
            <div>
              <dt>License</dt>
              <dd>
                <a href={githubBlob("LICENSE")} rel="noreferrer">{PACKAGE.license}</a>
              </dd>
            </div>
            <div>
              <dt>Module</dt>
              <dd>{PACKAGE.module}</dd>
            </div>
            <div>
              <dt>Node</dt>
              <dd>{PACKAGE.node}</dd>
            </div>
            <div>
              <dt>Dependencies</dt>
              <dd>{PACKAGE.runtimeDeps}</dd>
            </div>
          </dl>
      </div>

      <section class="wrap section">
        <div class="section-head">
          <div>
            <h2>Runtime</h2>
          </div>
          <p>
            Build a pipeline with <code>createSteps</code>, <code>step</code>, and <code>definePipeline</code>.
            Preview the selected steps with <code>plan()</code>, then execute with
            <code>run()</code> or <code>runOrThrow()</code>. The CLI uses the same pipeline definitions.
          </p>
        </div>
        <div class="facts">
          <article>
            <h3>Library</h3>
            <p>The library uses ESM imports and has no runtime dependencies. It supports Node.js 22+ on Linux and macOS.</p>
          </article>
          <article>
            <h3>CLI</h3>
            <p>Inspect, preview, and run pipelines from the terminal. The CLI requires Bun 1.3.14 or later.</p>
          </article>
          <article>
            <h3>Execution</h3>
            <p>Pipelines run in your Node.js process. No separate server is required.</p>
          </article>
        </div>
      </section>

      <section class="wrap section">
        <div class="feature">
          <div class="feature-copy">
            <h2 data-pipeline-stage>Define</h2>
            <p>
              Connect steps through their inputs and outputs. TypeScript checks the values
              passed between them, and Tubeless checks for missing dependencies,
              cycles, and duplicate IDs before execution.
            </p>
          </div>
          <figure class="shot">
            <TtyBar title="import.ts" host="library" />
            <CodeBlock code={FIRST_PIPELINE_SAMPLE} lang="ts" />
          </figure>
        </div>
      </section>

      <section class="wrap section">
        <div class="feature reverse">
          <div class="feature-copy">
            <h2 data-pipeline-stage>Plan</h2>
            <p>
              <code>plan()</code> lists the steps selected for a target without
              executing them. Export the dependency graph as Mermaid with
              <code>toMermaid()</code>.
            </p>
          </div>
          <MermaidGraph />
        </div>
      </section>

      <section class="wrap section">
        <div class="feature">
          <div class="feature-copy">
            <h2 data-pipeline-stage>Run</h2>
            <p>
              <code>run()</code> returns step results, failures, and timings.
              The terminal reporter displays progress during execution.
              Run history can be stored in SQLite or exported as NDJSON.
            </p>
          </div>
          <LiveTerminal />
        </div>
      </section>

      <section class="wrap section">
        <div class="feature reverse">
          <div class="feature-copy">
            <h2 data-pipeline-stage>Studio</h2>
            <p>
              Open recorded runs in your browser to inspect step timelines, logs, errors,
              and child pipelines. Register commands to preview and launch new runs.
            </p>
          </div>
          <figure class="shot">
            <TtyBar title="tubeless ui" host="studio" />
            <img
              src={href("studio.png")}
              width="1440"
              height="813"
              loading="lazy"
              alt="Local studio listing completed import and publish runs, with the import step timeline and a nested normalize run selected."
            />
          </figure>
        </div>
      </section>
    </PipelineFlow>
    <section class="wrap section" aria-labelledby="use-cases-heading">
      <div class="section-head">
        <h2 id="use-cases-heading">Use cases</h2>
        <p>See how Tubeless fits into release scripts, data jobs, and maintenance tasks.</p>
      </div>
      <div class="agent-grid">
        {USE_CASES.map((useCase) => (
          <a href={`${href("use-cases")}#${useCase.id}`}>
            <h3>{useCase.label}</h3>
            <p>{useCase.summary}</p>
          </a>
        ))}
      </div>
    </section>
    <section class="wrap section next-steps" aria-labelledby="next-heading">
      <h2 id="next-heading">Documentation</h2>
      <div class="agent-grid">
        <a href={href("start")}><h3>Getting started</h3></a>
        <a href={href("developers")}><h3>Developer resources</h3></a>
        <a href={href("agents")}><h3>Agent documentation</h3></a>
        <a href={href("docs/recipes")}><h3>Recipes</h3></a>
        <a href={href("docs/concepts")}><h3>Execution semantics</h3></a>
      </div>
    </section>
  </main>
</Base>
