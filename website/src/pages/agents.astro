---
import Base from "../layouts/Base.astro";
import { absUrl, githubBlob, href } from "../lib/paths";

const resources = [
  { name: "LLM index", url: href("llms.txt"), use: "Documentation index" },
  { name: "Complete documentation", url: href("llms-full.txt"), use: "All documentation in one text response" },
  { name: "Agent guide", url: href("docs/agent-guide.md"), use: "Primitive, runtime, and safety rules in Markdown" },
  { name: "Recipes", url: href("docs/recipes.md"), use: "Examples by use case" },
  { name: "API report", url: href("api-report.json"), use: "Public surface for automated review" },
  { name: "Skill", url: githubBlob("skills/tubeless/SKILL.md"), label: "skills/tubeless/SKILL.md", use: "Authoring workflow for this repo" },
  { name: "Project manifest", url: githubBlob("examples/catalog/tubeless.project.ts"), label: "examples/catalog/tubeless.project.ts", use: "File layout, registered IDs, exports" },
  { name: "Evaluations", url: href("docs/agent-evaluations.md"), use: "Forward-testing cases" },
];
---

<Base
  title="Agents"
  description="Machine-readable entrypoints for coding agents working with tubeless."
>
  <main class="wrap">
    <header class="page-lead">
      <h1 class="page-title">Agent documentation</h1>
      <p>
        Documentation is available as HTML, individual Markdown files, or one
        text file. The package includes <code>docs/</code> and <code>examples/</code>.
      </p>
      <div class="actions">
        <a class="btn" href={href("llms.txt")}>Documentation index</a>
        <a class="btn ghost" href={href("llms-full.txt")}>Full documentation (text)</a>
      </div>
      <div class="agent-handoff">
        <p id="agent-prompt">Read {absUrl("llms.txt")}, then the agent guide and the smallest matching recipe before writing a Tubeless pipeline.</p>
        <button class="btn ghost" type="button" data-copy={`Read ${absUrl("llms.txt")}, then the agent guide and the smallest matching recipe before writing a Tubeless pipeline.`}>Copy instructions</button>
      </div>
    </header>



    <section class="section">
      <h2>Resources</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Resource</th>
              <th>URL</th>
              <th>Use</th>
            </tr>
          </thead>
          <tbody>
            {resources.map((resource) => (
              <tr>
                <td>{resource.name}</td>
                <td><a href={resource.url}>{resource.label ?? resource.url}</a></td>
                <td>{resource.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>Authoring rules</h2>
      <div class="facts">
        <article>
          <h3>IDs</h3>
          <p>Keep step IDs stable. <code>name</code> is presentation only.</p>
        </article>
        <article>
          <h3>Dry-run</h3>
          <p>Side effects use <code>dryRun: "skip"</code> or a side-effect-free handler.</p>
        </article>
        <article>
          <h3>Errors</h3>
          <p>Branch on <code>PipelineError.code</code>, <code>phase</code>, and <code>kind</code>. Don't match error message text.</p>
        </article>
      </div>
    </section>
  </main>
</Base>
