---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { absUrl, githubBlob, href } from "../lib/paths";

const resources = [
  { name: "LLM index", url: href("llms.txt"), use: "Documentation index" },
  { name: "Complete documentation", url: href("llms-full.txt"), use: "All documentation in one text response" },
  { name: "Agent guide", url: href("docs/agent-guide.md"), use: "Pipeline authoring and execution rules in Markdown" },
  { name: "Recipes", url: href("docs/recipes.md"), use: "Examples by use case" },
  { name: "API report", url: href("api-report.json"), use: "Public TypeScript declarations for automated checks" },
  { name: "Skill pack", url: href("docs/agent-skills"), use: "Install skills for writing pipelines and converting existing code" },
  { name: "Make pipeline", url: githubBlob("skills/tubeless-make-pipeline/SKILL.md"), label: "tubeless-make-pipeline", use: "Convert existing code into a typed pipeline" },
  { name: "Pipeline project", url: githubBlob("examples/tubeless.project.ts"), label: "examples/tubeless.project.ts", use: "Group pipelines with defineProject for typed lookup, CLI, and Studio" },
];
---

<Base
  title="Agent Documentation"
  markdown="agents.md"
  description="Guides, examples, and installable skills for coding agents working with Tubeless."
>
  <main class="wrap">
    <header class="page-lead">
      <h1 class="page-title">Tubeless agent documentation</h1>
      <p>
        Documentation is available as HTML, individual Markdown files, or one
        text file. The package includes <code>docs/</code> and <code>examples/</code>.
      </p>
      <div class="actions">
        <a class="btn" href={href("llms.txt")}>Documentation index</a>
        <a class="btn ghost" href={href("llms-full.txt")}>Full documentation (text)</a>
      </div>
      <div class="agent-handoff">
        <p id="agent-prompt">Read {absUrl("llms.txt")}, then the agent guide and the simplest example that fits your task before writing a Tubeless pipeline.</p>
        <button class="btn ghost" type="button" data-copy={`Read ${absUrl("llms.txt")}, then the agent guide and the simplest example that fits your task before writing a Tubeless pipeline.`}>Copy instructions</button>
      </div>
    </header>



    <section class="section">
      <h2>Install the agent skill pack</h2>
      <CodeBlock code="npx skills add chetmancini/tubeless" lang="sh" />
      <p>
        Use <code>tubeless-make-pipeline</code> to turn existing scripts and workflows
        into typed pipelines, or <code>tubeless</code> for writing and editing pipelines.
        See the <a href={href("docs/agent-skills")}>installation guide and example prompt</a>.
      </p>
    </section>

    <section class="section">
      <h2>Resources</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Resource</th>
              <th>URL</th>
              <th>Use</th>
            </tr>
          </thead>
          <tbody>
            {resources.map((resource) => (
              <tr>
                <td>{resource.name}</td>
                <td><a href={resource.url}>{resource.label ?? resource.url}</a></td>
                <td>{resource.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>Authoring rules</h2>
      <div class="facts">
        <article>
          <h3>IDs</h3>
          <p>Keep step IDs stable. <code>name</code> only changes the display label.</p>
        </article>
        <article>
          <h3>Dry runs</h3>
          <p>For steps that write data or have other side effects, use <code>dryRun: "skip"</code> or a handler that previews the work without making changes.</p>
        </article>
        <article>
          <h3>Errors</h3>
          <p>Branch on <code>PipelineError.code</code>, <code>phase</code>, and <code>kind</code>. Don't match error message text.</p>
        </article>
      </div>
    </section>
  </main>
</Base>
