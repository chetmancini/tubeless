---
import Doc from "../../layouts/Doc.astro";
import { DOC_NAV } from "../../lib/docs";
import { href } from "../../lib/paths";

const human = DOC_NAV.filter((item) =>
  ["getting-started", "recipes", "concepts", "cli", "studio", "comparison"].includes(item.slug)
);
const deep = DOC_NAV.filter((item) =>
  ["child-pipeline-composition", "remote-step-composition", "api-reference"].includes(item.slug)
);
const agents = DOC_NAV.filter((item) =>
  ["agent-guide", "agent-skills"].includes(item.slug)
);
---

<Doc title="Developer Documentation" description="Tubeless developer documentation for the TypeScript package, CLI, Studio, and coding agents.">
  <h1>Tubeless developer documentation</h1>
  <p>
    Learn how to build a pipeline, choose execution controls, and inspect results.
    Start with the getting-started guide or find an example for your task.
  </p>

  <h2>Usage</h2>
  <div class="agent-grid">
    {human.map((item) => (
      <a href={href(`docs/${item.slug}`)}>
        <h3>{item.label}</h3>
        <p>{item.blurb}</p>
      </a>
    ))}
  </div>

  <h2>Agents</h2>
  <div class="agent-grid">
    <a href={href("agents")}>
      <h3>Agent resources</h3>
      <p>Installable skills, Markdown guides, and examples for coding agents.</p>
    </a>
    {agents.map((item) => (
      <a href={href(`docs/${item.slug}`)}>
        <h3>{item.label}</h3>
        <p>{item.blurb}</p>
      </a>
    ))}
  </div>

  <h2>Reference</h2>
  <div class="agent-grid">
    <a href={href("developers")}>
      <h3>Developer resources</h3>
      <p>Library and CLI documentation, the Studio guide, and downloadable references.</p>
    </a>
    {deep.map((item) => (
      <a href={href(`docs/${item.slug}`)}>
        <h3>{item.label}</h3>
        <p>{item.blurb}</p>
      </a>
    ))}
    <a href={href("api-report.json")}>
      <h3>api-report.json</h3>
      <p>Public TypeScript declarations in JSON for automated checks.</p>
    </a>
  </div>
</Doc>
