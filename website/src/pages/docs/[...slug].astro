---
import { getEntry, render } from "astro:content";
import Doc from "../../layouts/Doc.astro";
import { DOC_NAV, DOC_SLUGS, loadDoc } from "../../lib/docs";

export function getStaticPaths() {
  return DOC_NAV.map((doc) => ({
    params: { slug: doc.slug },
    props: { slug: doc.slug },
  }));
}

const slug = Astro.params.slug;
if (!slug || Array.isArray(slug) || !DOC_SLUGS.has(slug)) {
  throw new Error(`Unknown doc slug: ${String(slug)}`);
}

const doc = loadDoc(slug);
const entry = await getEntry("docs", slug);
if (!entry) throw new Error(`Missing documentation entry: ${slug}`);
const { Content, headings } = await render(entry);
const tableOfContents = headings
  .filter(({ depth }) => depth === 2 || depth === 3)
  .map(({ depth, slug: id, text }) => ({ id, text, level: depth }));
---

<Doc title={doc.title} description={doc.description} slug={doc.slug} headings={tableOfContents}>
  <Content />
</Doc>
