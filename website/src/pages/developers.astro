---
import Base from "../layouts/Base.astro";
import { href } from "../lib/paths";

const resources = [
  {
    title: "Package documentation",
    href: href("docs"),
    detail: "Installation, pipeline concepts, executable recipes, and CLI usage.",
  },
  {
    title: "TypeScript API inventory",
    href: href("docs/api-reference"),
    detail: "Generated public exports and signatures for the Tubeless package.",
  },
  {
    title: "Local Studio API guide",
    href: href("docs/studio"),
    detail: "Local HTTP behavior, request guards, capabilities, and operational boundaries.",
  },
  {
    title: "OpenAPI specification",
    href: href("openapi.json"),
    detail: "OpenAPI 3.1 operations and typed JSON success and error responses.",
  },
  {
    title: "Machine-readable API report",
    href: href("api-report.json"),
    detail: "Checked public TypeScript declarations for automated review.",
  },
  {
    title: "Agent documentation",
    href: href("agents"),
    detail: "Markdown entrypoints, authoring rules, examples, and evaluation cases.",
  },
];
---

<Base
  title="Developer Resources"
  markdown="developers.md"
  description="Tubeless developer resources: TypeScript package docs, CLI reference, Local Studio OpenAPI specification, and agent documentation."
>
  <main class="wrap">
    <header class="page-lead">
      <h1 class="page-title">Tubeless developer resources</h1>
      <p>
        Build typed TypeScript pipelines, integrate the CLI, or inspect the local
        Studio HTTP contract. Tubeless is a library and local tool, not a hosted
        execution API.
      </p>
    </header>

    <section class="section" aria-labelledby="resources-heading">
      <h2 id="resources-heading">Documentation and API references</h2>
      <div class="agent-grid">
        {resources.map((resource) => (
          <a href={resource.href}>
            <h3>{resource.title}</h3>
            <p>{resource.detail}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
