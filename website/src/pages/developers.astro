---
import Base from "../layouts/Base.astro";
import { href } from "../lib/paths";

const resources = [
  {
    title: "Pipeline document JSON Schema",
    href: href("schemas/pipeline-document-v1.schema.json"),
    detail: "Validate YAML and JSON pipeline documents in your editor or coding agent.",
  },
  {
    title: "Package documentation",
    href: href("docs"),
    detail: "Installation, pipeline concepts, executable recipes, and CLI usage.",
  },
  {
    title: "TypeScript API reference",
    href: href("docs/api-reference"),
    detail: "Generated public exports and signatures for the Tubeless package.",
  },
  {
    title: "Studio guide",
    href: href("docs/studio"),
    detail: "Record runs, inspect results in your browser, and configure local access.",
  },
  {
    title: "Machine-readable API report",
    href: href("api-report.json"),
    detail: "Public TypeScript declarations in JSON for automated checks.",
  },
  {
    title: "Agent documentation",
    href: href("agents"),
    detail: "Installable skills, Markdown guides, and examples for coding agents.",
  },
];
---

<Base
  title="Developer Resources"
  markdown="developers.md"
  description="Tubeless developer resources: TypeScript package docs, CLI reference, Studio guide, and agent documentation."
>
  <main class="wrap">
    <header class="page-lead developer-lead">
      <h1 class="page-title">Tubeless developer resources</h1>
      <p>
        Find guides for building TypeScript pipelines, running CLI commands, and
        using Studio. API references cover the supported library exports.
      </p>
    </header>

    <section class="section developer-resources" aria-labelledby="resources-heading">
      <h2 id="resources-heading">Documentation and API references</h2>
      <div class="agent-grid">
        {resources.map((resource) => (
          <a href={resource.href}>
            <h3>{resource.title}</h3>
            <p>{resource.detail}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .developer-lead .page-title { font-size: clamp(3.6rem, 6vw, 5.4rem); }
  .developer-resources { padding-top: 3rem; }
  .developer-resources .agent-grid { gap: 1.25rem; margin-top: 2rem; }
  .developer-resources .agent-grid a { min-height: 10rem; padding: 2rem; }

  @media (max-width: 700px) {
    .developer-resources { padding-top: 2.4rem; }
    .developer-resources .agent-grid { margin-top: 1.5rem; }
    .developer-resources .agent-grid a { min-height: 0; padding: 1.5rem; }
  }
</style>
