---
import Base from "../layouts/Base.astro";
import { href } from "../lib/paths";
---

<Base title="Not found" description="That page is not on the tubeless site.">
  <main class="wrap page-lead">
    <p class="kicker">404</p>
    <h1 class="page-title">Page not found</h1>
    <p>That URL is not a page. Try <a href={href()}>home</a>, <a href={href("docs")}>docs</a>, or <a href={href("agents")}>agents</a>.</p>
  </main>
</Base>
