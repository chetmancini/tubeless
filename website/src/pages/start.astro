---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Install from "../components/Install.astro";
import Terminal from "../components/Terminal.astro";
import { FIRST_PIPELINE_SAMPLE, PROJECT_SAMPLE } from "../data/code-samples";
import { graphTape, runTape } from "../data/tapes";
import { href } from "../lib/paths";
---

<Base markdown="docs/getting-started.md" title="Getting started" description="Install Tubeless and write, run, and test a small pipeline.">
  <main class="wrap">
    <header class="page-lead">
      <h1 class="page-title">First pipeline</h1>
      <p>
        Build a pipeline that reads a list of strings and normalizes each row.
        Use Node.js 22.6+ for library code or Bun 1.3.14+ for the CLI.
      </p>
    </header>

    <section class="section">
      <div class="split">
        <div>
          <h3>Install the library</h3>
          <Install command="npm install tubeless" />
          <p class="lede">You can also install with pnpm, Yarn, or Bun. Use ESM imports; the library has no runtime dependencies.</p>
        </div>
        <div>
          <h3>Use the CLI</h3>
          <Install command="bunx tubeless --help" />
          <p class="lede">The <code>tubeless</code> executable requires Bun 1.3.14 or later on <code>PATH</code>.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Define a pipeline</h2>
      <p class="lede">
        Use <code>createSteps</code> to get a typed <code>step</code> function.
        Define each step and connect it to its dependencies with <code>dependsOn</code>.
        The normalize step receives the load step’s output, with its type inferred automatically.
      </p>
      <CodeBlock code={FIRST_PIPELINE_SAMPLE} lang="ts" />
      <p class="lede">
        The last step in execution order is the default target and supplies the result.
        Here, that is <code>normalize</code>. If it produces no output, the result is
        <code>undefined</code>. Add a finalizer with <code>requireOutputs</code> when missing
        output should fail the run.
      </p>
    </section>

    <section class="section">
      <div class="feature">
        <div class="feature-copy">
          <h3>View the dependency graph</h3>
          <p>
            <code>toMermaid()</code> returns a Mermaid diagram of the dependencies. Solid arrows
            show required inputs; dotted arrows show optional inputs and failure gates.
            The CLI’s <code>tubeless graph</code> command returns the same diagram.
          </p>
        </div>
        <Terminal tape={graphTape} />
      </div>
    </section>

    <section class="section">
      <div class="feature reverse">
        <div class="feature-copy">
          <h3>Run or preview the pipeline</h3>
          <p>
            Use <code>runOrThrow</code> to receive the final value or an exception. Use <code>run</code>
            to inspect step results and errors. Use <code>plan</code> to see which steps would run without
            running steps. For CLI scripts, <code>definePipelineCommand(pipeline)</code> infers
            flags from the input schema and supplies help, selection, dry runs, and reporting.
          </p>
          <p class="lede">
            Start with <code>examples/automatic-cli.ts</code> for the one-line wrapper.
            The terminal shows the advanced file-to-rows adapter in <code>examples/cli-job.ts</code>;
            explicit flag definitions and option mapping are only needed for custom inputs.
          </p>
        </div>
        <Terminal tape={runTape} />
      </div>
    </section>

    <section class="section">
      <h2>Share a project with CLI and Studio</h2>
      <p class="lede">
        Register each pipeline exactly once in <code>tubeless.project.ts</code>.
        Put schema-backed pipelines directly in the list; use a command entry when
        you need explicit parameters or option mapping. A command registers its
        underlying pipeline, and <code>project.get(id)</code> keeps its exact types.
      </p>
      <CodeBlock code={PROJECT_SAMPLE} lang="ts" />
    </section>

    <section class="section">
      <div class="agent-grid">
        <a href={href("docs/getting-started")}>
          <h3>Getting started</h3>
          <p>Run your first pipeline, select steps, and test its results.</p>
        </a>
        <a href={href("docs/recipes")}>
          <h3>Recipe index</h3>
          <p>Examples by use case.</p>
        </a>
        <a href={href("docs/cli")}>
          <h3>CLI</h3>
          <p>Preview and run commands, record history, and handle exit codes.</p>
        </a>
        <a href={href("docs/studio")}>
          <h3>Studio</h3>
          <p>View logs and progress, preview plans, and run registered commands in a browser.</p>
        </a>
      </div>
    </section>
  </main>
</Base>
