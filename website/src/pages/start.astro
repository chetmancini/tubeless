---
import Base from "../layouts/Base.astro";
import Install from "../components/Install.astro";
import Terminal from "../components/Terminal.astro";
import { graphTape, runTape } from "../data/tapes";
import { href } from "../lib/paths";
---

<Base markdown="start.md" title="Start" description="Install tubeless, define a first pipeline, and choose how to run it.">
  <main class="wrap">
    <header class="page-lead">
      <h1 class="page-title">First pipeline</h1>
      <p>
        Build a pipeline that reads a list of strings and normalizes each row.
        Use Node.js 22+ for library code or Bun 1.3.14+ for the CLI.
      </p>
    </header>

    <section class="section">
      <div class="split">
        <div>
          <h3>Install the library</h3>
          <Install command="npm install tubeless" />
          <p class="lede">You can also install with pnpm, Yarn, or Bun. Use ESM imports; the library has no runtime dependencies.</p>
        </div>
        <div>
          <h3>Use the CLI</h3>
          <Install command="bunx tubeless --help" />
          <p class="lede"><code>npx tubeless</code> works if Bun is installed; otherwise it prints install instructions.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Define a pipeline</h2>
      <p class="lede">
        Create steps with <code>createSteps</code>, then connect them with <code>dependsOn</code>.
        The normalize step receives the load step’s output, with its type inferred automatically.
      </p>
      <pre><code>{`import { createSteps, definePipeline, requireOutputs } from "tubeless";

interface ImportOptions {
  lines: readonly string[];
}

const step = createSteps<ImportOptions>();

const load = step("load", {
  run: (_inputs, context) => context.options.lines,
});

const normalize = step("normalize", {
  dependsOn: [load],
  run: ({ load: rows }) =>
    rows.map((row) => row.trim().toLowerCase()).filter(Boolean),
});

export const ImportPipeline = definePipeline({
  id: "import",
  steps: [load, normalize],
  targets: [normalize],
  finalize: requireOutputs([normalize], ({ normalize }) => normalize),
});`}</code></pre>
    </section>

    <section class="section">
      <div class="feature">
        <div class="feature-copy">
          <h3>See the static graph</h3>
          <p>
            <code>toMermaid()</code> returns a Mermaid diagram of the dependencies. Solid arrows
            show required inputs; dotted arrows show optional inputs and failure gates.
            The CLI’s <code>tubeless graph</code> command returns the same diagram.
          </p>
        </div>
        <Terminal tape={graphTape} />
      </div>
    </section>

    <section class="section">
      <div class="feature reverse">
        <div class="feature-copy">
          <h3>Pick an execution method</h3>
          <p>
            Use <code>runOrThrow</code> to receive the final value or an exception. Use <code>run</code>
            to inspect step results and errors. Use <code>plan</code> to preview selection without
            running steps. For CLI scripts, <code>definePipelineCommand</code> supplies help,
            selection flags, and dry-run controls.
          </p>
        </div>
        <Terminal tape={runTape} />
      </div>
    </section>

    <section class="section">
      <div class="agent-grid">
        <a href={href("docs/getting-started")}>
          <h3>Getting started</h3>
          <p>Run your first pipeline, select steps, and test its results.</p>
        </a>
        <a href={href("docs/recipes")}>
          <h3>Recipe index</h3>
          <p>Examples by use case.</p>
        </a>
        <a href={href("docs/cli")}>
          <h3>CLI</h3>
          <p>Preview and run commands, record history, and handle exit codes.</p>
        </a>
        <a href={href("docs/studio")}>
          <h3>Studio</h3>
          <p>View logs and progress, preview plans, and run registered commands in a browser.</p>
        </a>
      </div>
    </section>
  </main>
</Base>
